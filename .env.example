# Opcionales; valores predeterminados del servidor HTTP local.
# El servidor lee variables de entorno del proceso; este archivo no se carga automáticamente.
TRUCO_SERVER_HOST=127.0.0.1
TRUCO_SERVER_PORT=3000

# Opcional: ruta SQLite relativa a apps/server o absoluta, con prefijo file:.
# Sin definirla se usa apps/server/prisma/dev.db.
DATABASE_URL=file:./prisma/dev.db
